<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<StackPane fx:id="rootPane" prefHeight="1080.0" prefWidth="1920.0" styleClass="root" stylesheets="@PantallaMenu.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vista.PantallaCargaPartida">
   <children>
      <!-- Background Image (Optional, same as menu or different) -->
      <ImageView fitHeight="1080.0" fitWidth="1920.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../assets/fondo_menu.png" />
         </image>
      </ImageView>
      
      <VBox alignment="CENTER" spacing="60.0" style="-fx-background-color: rgba(13, 27, 42, 0.7);">
         <children>
            <VBox alignment="CENTER" spacing="20.0">
               <children>
                  <Label styleClass="title" text="PREPARANDO EXPEDICIÓN" />
                  <ProgressBar fx:id="progressBar" prefWidth="600.0" progress="0.0" />
               </children>
            </VBox>
            
            <VBox alignment="CENTER" maxWidth="900.0" spacing="20.0" styleClass="card">
               <padding>
                  <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
               </padding>
               <children>
                  <HBox alignment="CENTER" spacing="15.0">
                     <children>
                        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../assets/pingu_icon.png" />
                           </image>
                        </ImageView>
                        <Label style="-fx-text-fill: #7FD4F0; -fx-font-size: 24px; -fx-font-weight: bold;" text="CONSEJO DEL DÍA" />
                     </children>
                  </HBox>
                  <Label fx:id="tipLabel" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-text-alignment: center;" text="Cargando consejo..." wrapText="true" />
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</StackPane>
