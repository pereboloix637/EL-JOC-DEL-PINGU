<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.media.MediaView?>

<StackPane fx:id="rootPane" prefHeight="1080.0" prefWidth="1920.0" styleClass="root" stylesheets="@PantallaCarga.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vista.PantallaCarga">
   <children>
      <!-- El vídeo de fondo -->
      <MediaView fx:id="mediaView" fitHeight="1080.0" fitWidth="1920.0" preserveRatio="true" />
      
      <!-- Overlay con progreso - Fondo transparente como se solicitó -->
      <VBox alignment="BOTTOM_CENTER" spacing="50.0" style="-fx-background-color: transparent; -fx-padding: 0 0 150 0;">
         <children>
            <VBox alignment="CENTER" spacing="20.0">
               <children>
                  <ProgressBar fx:id="progressBar" prefWidth="600.0" progress="0.0" />
                  <Label fx:id="loadingLabel" styleClass="loading-label" text="Cargando recursos..." textFill="WHITE" />
               </children>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </VBox>
         </children>
         <StackPane.margin>
            <Insets />
         </StackPane.margin>
      </VBox>
   </children>
</StackPane>
