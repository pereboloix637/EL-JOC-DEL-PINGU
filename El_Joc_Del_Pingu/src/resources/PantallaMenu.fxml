<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="Infinity" maxWidth="Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="1080" prefWidth="1920" styleClass="root" stylesheets="@PantallaMenu.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vista.PantallaMenu">

    <center>
        <StackPane fx:id="menuRoot" BorderPane.alignment="CENTER">
            <AnchorPane fx:id="menuContainer" prefHeight="1080.0" prefWidth="1920.0">
                <!-- BACKGROUND IMAGE CONTAINER -->
                <StackPane mouseTransparent="true" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <ImageView fx:id="backgroundImageView" fitHeight="1080.0" fitWidth="1920.0" pickOnBounds="true" preserveRatio="true" smooth="false">
                        <image>
                            <Image url="@../assets/fondo_menu.png" />
                        </image>
                    </ImageView>
                </StackPane>
                

                
                   <!-- LOGO PCI -->
                <ImageView fitHeight="120.0" fitWidth="216.0" pickOnBounds="true" preserveRatio="true" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
                    <image>
                        <Image url="@../assets/LogoPCI.png" />
                    </image>
                </ImageView>
                
                <!-- LANDING SCREEN -->
                <VBox fx:id="landingContainer" alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" spacing="20" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="100.0">
                    <ImageView fitWidth="800.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@../assets/TITULO_MENU.png" />
                        </image>
                    </ImageView>
                </VBox>

                      <!-- REGLAS / DESCRIPCION (Izquierda) -->
                <VBox fx:id="rulesContainer" alignment="CENTER_LEFT" maxWidth="480" prefHeight="729.0" prefWidth="391.0" spacing="12" styleClass="card" AnchorPane.bottomAnchor="60.0" AnchorPane.leftAnchor="60.0">
                    <padding>
                        <Insets bottom="20" left="20" right="20" top="20" />
                    </padding>
                    <Label style="-fx-font-size: 24px; -fx-text-fill: white; -fx-font-weight: bold;" text="❄ CÓMO JUGAR ❄" wrapText="true" />
                    <Separator />
                    <Label style="-fx-font-size: 14px; -fx-text-fill: white; -fx-line-spacing: 3;" text="El objetivo es conseguir llegar a la meta antes que tus oponentes." wrapText="true" />
                    <Label style="-fx-font-size: 14px; -fx-text-fill: white; -fx-line-spacing: 3;" text="En tu turno, tira los dados y muévete por los suelos helados hacia la meta." wrapText="true" />
                    <Label style="-fx-font-size: 14px; -fx-text-fill: white; -fx-line-spacing: 3;" text="Tu misión es evitar los agujeros u osos y utilizar los trineos y casillas de evento a tu favor." wrapText="true" />
                    <Label style="-fx-font-size: 14px; -fx-text-fill: white; -fx-line-spacing: 3;" text="Los pingüinos son los jugadores, mientras que las Focas son los bots que no tienen inventario, pero pueden causarte problemas en tu travesía." wrapText="true" />
                    <Label style="-fx-font-size: 14px; -fx-text-fill: white; -fx-line-spacing: 3;" text="La partida termina cuando un jugador llega a la meta (la casilla 50)." wrapText="true" />
                    <Separator />
                    <Label style="-fx-font-size: 15px; -fx-text-fill: #7FD4F0; -fx-font-weight: bold; -fx-line-spacing: 3;" text="¿Qué me dices? ¿Llegarás al final o sucumbirás ante el tablero y sus peligros?" textAlignment="CENTER" wrapText="true" />
                </VBox>

                <!-- MENU BUTTONS - Integrated Options & Enlarged -->
                <VBox alignment="BOTTOM_RIGHT" maxHeight="-Infinity" maxWidth="-Infinity" spacing="20" AnchorPane.bottomAnchor="60.0" AnchorPane.rightAnchor="60.0">
                    <Button minWidth="320" onAction="#handleOpenNewGame" prefHeight="68.0" prefWidth="385.0" styleClass="landing-nav-button" text="NUEVA PARTIDA" />
                    <Button minWidth="320" onAction="#handleOpenLoadGame" prefHeight="68.0" prefWidth="386.0" styleClass="landing-nav-button" text="CARGAR PARTIDA" />
                    <Button minWidth="320" onAction="#handleOpenRanking" prefHeight="68.0" prefWidth="385.0" styleClass="landing-nav-button" text="RANKING" />
                    <Button minWidth="320" onAction="#handleToggleSettings" prefHeight="68.0" prefWidth="385.0" styleClass="landing-nav-button" text="OPCIONES" />
                    <Button minWidth="320" onAction="#handleQuitGame" styleClass="landing-nav-button, quit-button" text="SALIR DEL JUEGO" />
                </VBox>

                <!-- CONTENT AREA (Drill-down) -->
                <VBox fx:id="contentContainer" managed="false" maxWidth="800" spacing="20" visible="false" AnchorPane.bottomAnchor="40.0" AnchorPane.leftAnchor="560.0" AnchorPane.rightAnchor="560.0" AnchorPane.topAnchor="40.0">
                    <HBox alignment="CENTER_LEFT">
                        <Button onAction="#handleBackToLanding" styleClass="back-button" text="← VOLVER AL MENÚ" />
                        <Region HBox.hgrow="ALWAYS" />
                        <VBox alignment="CENTER_RIGHT" spacing="5">
                            <Label fx:id="dbStatusLabel" style="-fx-text-fill: #7FD4F0; -fx-font-size: 12px;" text="" visible="false" />
                            <javafx.scene.control.ProgressBar fx:id="dbProgressBar" prefWidth="150.0" visible="false" />
                        </VBox>
                    </HBox>

                    <VBox spacing="16" styleClass="card" VBox.vgrow="ALWAYS">
                        <padding>
                            <Insets bottom="20" left="20" right="20" top="20" />
                        </padding>
                        
                        <javafx.scene.control.TabPane fx:id="mainTabPane" side="TOP" styleClass="hidden-header" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                            <tabs>
                                <!-- NUEVA PARTIDA -->
                                <javafx.scene.control.Tab text="Nueva Partida">
                                    <content>
                                        <VBox spacing="15">
                                            <Label styleClass="section-title" text="NUEVA EXPEDICIÓN" />
                                            <Label styleClass="hint" text="Añade jugadores (2-4, mín. 1 humano)." wrapText="true" />
                                            <Separator />
                                            <javafx.scene.control.ListView fx:id="playersList" prefHeight="250" styleClass="players-list" />
                                            
                                            <VBox spacing="8" styleClass="login-mini-card">
                                                <TextField fx:id="userField" promptText="Nombre de usuario..." />
                                                <PasswordField fx:id="passField" promptText="Contraseña..." />
                                                <HBox spacing="10">
                                                    <Button maxWidth="Infinity" onAction="#handleLogin" styleClass="secondary" text="+ Humano" HBox.hgrow="ALWAYS" />
                                                    <Button maxWidth="Infinity" onAction="#handleAddCPU" styleClass="secondary" text="+ CPU" HBox.hgrow="ALWAYS" />
                                                </HBox>
                                            </VBox>
                                            <Region VBox.vgrow="ALWAYS" />
                                            <Button fx:id="startGameButton" maxWidth="Infinity" onAction="#handleStartGame" styleClass="primary-large" text="COMENZAR" />
                                        </VBox>
                                    </content>
                                </javafx.scene.control.Tab>

                                <!-- CARGAR PARTIDA -->
                                <javafx.scene.control.Tab text="Cargar Partida">
                                    <content>
                                        <VBox spacing="15">
                                            <Label styleClass="section-title" text="CONTINUAR AVENTURA" />
                                            <Label styleClass="field-label" text="Partidas guardadas:" />
                                            <javafx.scene.control.ListView fx:id="savedGamesList" VBox.vgrow="ALWAYS" />
                                            <Label fx:id="deleteFeedbackLabel" text="" visible="false" />
                                            <HBox spacing="10">
                                                <Button maxWidth="Infinity" onAction="#handleRefreshGames" text="Actualizar" HBox.hgrow="ALWAYS" />
                                                <Button maxWidth="Infinity" onAction="#handleDeleteGame" styleClass="delete-button" text="Borrar" HBox.hgrow="ALWAYS" />
                                            </HBox>
                                            <Button maxWidth="Infinity" onAction="#handleStartGame" styleClass="primary-large" text="CARGAR" />
                                        </VBox>
                                    </content>
                                </javafx.scene.control.Tab>

                                <!-- RANKING -->
                                <javafx.scene.control.Tab text="Ranking (Victorias)">
                                    <content>
                                        <VBox spacing="15">
                                            <Label styleClass="section-title" text="SALÓN DE LA FAMA" />
                                            <javafx.scene.control.ListView fx:id="rankingList" VBox.vgrow="ALWAYS" />
                                            <Button maxWidth="Infinity" onAction="#handleRefreshRanking" text="Actualizar Ranking" />
                                        </VBox>
                                    </content>
                                </javafx.scene.control.Tab>
                            </tabs>
                        </javafx.scene.control.TabPane>
                    </VBox>
                </VBox>
                <!-- SETTINGS CONTAINER (FOR CENTERING WITHOUT FILLING) -->
                <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" pickOnBounds="false">
                    <VBox fx:id="settingsPane" alignment="TOP_LEFT" managed="false" maxHeight="-Infinity" maxWidth="-Infinity" mouseTransparent="false" pickOnBounds="true" prefWidth="350.0" spacing="12" styleClass="settings-pane-ref" visible="false">
                        <padding>
                            <Insets bottom="15" left="20" right="20" top="12" />
                        </padding>
                        
                        <!-- HEADER -->
                        <HBox alignment="CENTER_LEFT">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label styleClass="settings-title-ref" text="AJUSTES" />
                                <Separator styleClass="settings-separator-ref" />
                            </VBox>
                            <Button onAction="#handleToggleSettings" styleClass="close-button-ref" text="✕" translateY="-8" translateX="8" />
                        </HBox>

                        <!-- MUSICA SECTION -->
                        <VBox spacing="8">
                            <Label styleClass="settings-label-ref" text="Música" />
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <Button fx:id="btnMute" onAction="#handleToggleMute" styleClass="mute-button-ref">
                                    <graphic>
                                        <ImageView fx:id="imgMute" fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                            <image>
                                                <Image url="@../assets/speaker_on.png" />
                                            </image>
                                        </ImageView>
                                    </graphic>
                                </Button>
                                <Slider fx:id="musicSlider" max="1.0" min="0.0" prefWidth="220.0" value="0.5" styleClass="settings-slider-ref" />
                            </HBox>
                        </VBox>
                        
                        <!-- EFECTOS SECTION -->
                        <VBox spacing="8">
                            <Label styleClass="settings-label-ref" text="Efectos" />
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <Button fx:id="btnMuteSfx" onAction="#handleToggleSfxMute" styleClass="mute-button-ref">
                                    <graphic>
                                        <ImageView fx:id="imgMuteSfx" fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                            <image>
                                                <Image url="@../assets/speaker_on.png" />
                                            </image>
                                        </ImageView>
                                    </graphic>
                                </Button>
                                <Slider fx:id="sfxSlider" max="1.0" min="0.0" prefWidth="220.0" value="0.5" styleClass="settings-slider-ref" />
                            </HBox>
                        </VBox>
                    </VBox>
                </StackPane>
            </AnchorPane>
        </StackPane>
    </center>
</BorderPane>
