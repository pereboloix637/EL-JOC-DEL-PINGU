<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane
    xmlns="http://javafx.com/javafx/21.0.10"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="vista.PantallaMenu"
    stylesheets="@PantallaMenu.css"
    styleClass="root">

    <top>
        <MenuBar>
            <menus>
                <Menu mnemonicParsing="false" text="File">
                    <items>
                        <MenuItem fx:id="newGame" mnemonicParsing="false" text="New" />
                        <SeparatorMenuItem mnemonicParsing="false" />
                        <MenuItem fx:id="saveGame" mnemonicParsing="false" text="Save" />
                        <MenuItem fx:id="loadGame" mnemonicParsing="false" text="Load" />
                        <SeparatorMenuItem mnemonicParsing="false" />
                        <MenuItem fx:id="quitGame" mnemonicParsing="false" text="Quit" />
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>

    <center>
        <StackPane>
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <VBox maxWidth="500" spacing="16" styleClass="card">
                <padding>
                    <Insets bottom="20" left="20" right="20" top="20" />
                </padding>

                <VBox alignment="CENTER" spacing="6">
                    <Label styleClass="title" text="EL JUEGO DEL PINGÜINO" wrapText="true" />
                    <Label styleClass="subtitle" text="Configura tu expedición ártica" />
                </VBox>

                <javafx.scene.control.TabPane fx:id="mainTabPane" side="TOP" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                    <tabs>
                        <!-- NUEVA PARTIDA -->
                        <javafx.scene.control.Tab text="Nueva Partida">
                            <content>
                                <VBox spacing="15" style="-fx-padding: 15;">
                                    <VBox spacing="10" VBox.vgrow="ALWAYS">
                                        <Label styleClass="hint" text="Todas las partidas tendrán 4 jugadores. Las plazas vacías se llenarán con CPUs." wrapText="true" />
                                        <Separator />
                                        <Label styleClass="field-label" text="Jugadores Humanos (Mínimo 1):" />
                                        <javafx.scene.control.ListView fx:id="playersList" prefHeight="100" styleClass="players-list" />
                                        
                                        <VBox spacing="5" styleClass="login-mini-card">
                                            <TextField fx:id="userField" promptText="Nombre de usuario..." styleClass="field-small" />
                                            <PasswordField fx:id="passField" promptText="Contraseña..." styleClass="field-small" />
                                            <Button maxWidth="Infinity" onAction="#handleLogin" styleClass="secondary" text="Añadir Jugador" />
                                        </VBox>
                                    </VBox>
                                </VBox>
                            </content>
                        </javafx.scene.control.Tab>

                        <!-- CARGAR PARTIDA -->
                        <javafx.scene.control.Tab text="Cargar Partida">
                            <content>
                                <VBox spacing="15" style="-fx-padding: 15;">
                                    <Label styleClass="field-label" text="Selecciona una partida guardada:" />
                                    <javafx.scene.control.ListView fx:id="savedGamesList" VBox.vgrow="ALWAYS" />
                                    <Button maxWidth="Infinity" onAction="#handleRefreshGames" text="Actualizar Lista" />
                                </VBox>
                            </content>
                        </javafx.scene.control.Tab>
                    </tabs>
                </javafx.scene.control.TabPane>

                <Button fx:id="startGameButton" maxWidth="Infinity" onAction="#handleStartGame" styleClass="primary-large" text="COMENZAR PARTIDA" />
            </VBox>
        </StackPane>
    </center>

</BorderPane>